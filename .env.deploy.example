# VPS connection (also used as GitHub Secrets in CI)
DEPLOY_HOST=blog-mcp.yourdomain.com
DEPLOY_USER=deploy-blog-mcp
DEPLOY_PATH=/opt/apps/blog-mcp

# SSH private key (only needed in CI; locally uses your default SSH key)
SSH_PRIVATE_KEY=

# Blog repository (also add BLOG_REPO_URL as a GitHub Secret for the Setup VPS workflow)
BLOG_REPO_URL=git@github.com:user/blog.git
GIT_REPO_PATH=/opt/apps/blog-mcp/blog-repo
GIT_BRANCH=main