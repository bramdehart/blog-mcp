# VPS connection
DEPLOY_HOST=blog-mcp.bramdehart.nl
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/apps/blog-mcp

# Blog repository
BLOG_REPO_URL=git@github.com:user/blog.git
GIT_REPO_PATH=/opt/apps/blog-mcp/blog-repo
